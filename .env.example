# ============================================================
# RuaTrip（Rua途）v2.0 — 环境变量样例
# 复制为 .env 后填写。所有 AI / 3D / 语音能力都是「可选接入」：
# 未配置时系统自动回落到本地 Mock Provider，全站功能依然完整可用。
# 详细接入说明见 docs/API-INTEGRATION.md
# ============================================================

# ---------- 服务端基础 ----------
PORT=8787
NODE_ENV=development
# 前端来源，用于 CORS（多个用逗号分隔）
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# 数据落盘目录（轻量 JSON 存储，可替换为真实数据库）
DATA_DIR=./.data

# ---------- 认证（审计 B2） ----------
# 生产环境**必须**配置，否则服务端会拒绝启动（用可预测密钥签名等于没有鉴权）。
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# required（默认）：未登录一律 401
# optional：仅当库里只有一个「遗留占位账号」（@legacy.local，由旧版单用户数据迁移而来）时
#           允许匿名请求落到它，用于平滑迁移老部署。正常注册的账号永远不允许匿名访问。
AUTH_MODE=required

# ---------- 持久化（审计 B1） ----------
# auto（默认）：DATABASE_URL 是 postgres:// → Postgres；否则 → SQLite
# file：JSON 文件（容器重建会丢数据，仅适合本地开发）
STORAGE_DRIVER=auto
# Postgres 连接串（多实例部署的唯一正确选择）；需要先 npm i pg
DATABASE_URL=
PG_SSL=true
# SQLite 文件路径；不设则用 <DATA_DIR>/ruatrip.db
SQLITE_FILE=

# ---------- 限流（审计 S5） ----------
# 设为 1 可完全关闭限流。仅用于集成测试或「前面已有网关限流」的内网部署，
# 公网生产环境不要开：按次计费的接口会失去保护。
RATE_LIMIT_DISABLED=

# ---------- 服务端 AI 能力（服务端持有密钥，前端永不接触） ----------

# ============================================================
# 1) 大模型对话（真心话小屋「自由层」）—— 二选一即可
# ============================================================
# 优先级：LLM_* 通用通道 > ANTHROPIC_* > 本地 Mock 模板
#
# 【推荐｜国产平台，可用支付宝/微信付款，不需要海外信用卡】
# 任意提供 OpenAI 兼容端点的模型都能挂上，只改这三行即可切换供应商：
#
#   供应商        LLM_BASE_URL                              LLM_MODEL
#   ---------------------------------------------------------------
#   DeepSeek      https://api.deepseek.com                  deepseek-flash
#   智谱 GLM      https://open.bigmodel.cn/api/paas/v4      glm-4-flash
#   通义千问      https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
#   Kimi          https://api.moonshot.cn/v1                moonshot-v1-8k
#   硅基流动      https://api.siliconflow.cn/v1             Qwen/Qwen3-8B
#   自建 vLLM     http://localhost:8000/v1                  你的模型名
#
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 【备选｜需要海外信用卡，一般较贵】Anthropic Claude
# 注意：LLM_* 配了的话会优先用它，Claude 会被忽略
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
CHAT_MODEL=claude-sonnet-4-5

# 【向后兼容别名】效果与 LLM_* 相同，LLM_* 优先
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# 2) 3D 形象生成（文字/图片 → 几何 + PBR 贴图）
TRIPO_API_KEY=
TRIPO_BASE_URL=https://api.tripo3d.ai/v2/openapi
MESHY_API_KEY=
MESHY_BASE_URL=https://api.meshy.ai/openapi/v2

# 3) 自动绑定骨骼 + 动物动画
ANYTHING_WORLD_API_KEY=
ANYTHING_WORLD_BASE_URL=https://api.anything.world

# 4) 语音合成（宠物专属音色）
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1

# 5) 语音识别（按住说话）
ASR_API_KEY=
ASR_BASE_URL=
ASR_MODEL=

# 6) 图像合成 / 手账排版（旅行照片合成、明信片）
IMAGE_COMPOSER_API_KEY=
IMAGE_COMPOSER_BASE_URL=

# 8) 对象存储（审计 B3：上传照片不再以 base64 存进 JSON）
# 四个必填项齐全就自动用 S3 兼容驱动；否则回落到本地磁盘（零配置可用）。
# Cloudflare R2 / 腾讯云 COS / 阿里云 OSS / MinIO / AWS S3 都是 S3 协议。
#
#   供应商         STORAGE_ENDPOINT                        STORAGE_REGION
#   ---------------------------------------------------------------------
#   Cloudflare R2  https://<账号id>.r2.cloudflarestorage.com   auto
#   腾讯云 COS     https://cos.<region>.myqcloud.com          ap-guangzhou
#   阿里云 OSS     https://oss-cn-hangzhou.aliyuncs.com       cn-hangzhou
#   MinIO（自建）  http://127.0.0.1:9000                       us-east-1
#
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto
# 用 MinIO 等需要 path-style 的服务时设为 true
STORAGE_FORCE_PATH_STYLE=
# 公开访问前缀（CDN 域名）。留空则用 endpoint/bucket
CDN_BASE_URL=
# 单张图片体积上限（字节），默认 4MB
MAX_IMAGE_BYTES=4194304

# ---------- 推送（审计 F2）----------
# 三个都配上才算接入真实推送通道。未配置时回落到「应用内通知列表」，
# 不会假装投递成功。微信内置浏览器完全不支持 Web Push，国内上线建议走 App 端 APNs/FCM。
PUSH_ENDPOINT=
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=

# ---------- 行为埋点（审计 F3）----------
# 只上报行为计数与时序：不含对话内容、照片、宠物名、邮箱。
# 未配置时事件留在进程内，可通过 GET /api/analytics/export 导出。
ANALYTICS_ENDPOINT=
ANALYTICS_WRITE_KEY=

# ---------- 支付（审计 F6）----------
# 未配置时订阅为「模拟开通」，但仍受消费限额约束（未成年人单笔/月上限）。
PAYMENT_PROVIDER=
PAYMENT_MERCHANT_ID=
PAYMENT_API_KEY=

# ---------- 前端（Vite，构建期注入） ----------
# 前端只拿到 API 基地址，绝不放任何第三方密钥
VITE_API_BASE_URL=/api
VITE_APP_NAME=RuaTrip
