# ============================================================
# RuaTrip（Rua途）v2.0 — 环境变量样例
# 复制为 .env 后填写。所有 AI / 3D / 语音能力都是「可选接入」：
# 未配置时系统自动回落到本地 Mock Provider，全站功能依然完整可用。
# 详细接入说明见 docs/API-INTEGRATION.md
# ============================================================

# ---------- 服务端基础 ----------
PORT=8787
NODE_ENV=development
# 前端来源，用于 CORS（多个用逗号分隔）
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# 数据落盘目录（轻量 JSON 存储，可替换为真实数据库）
DATA_DIR=./.data

# ---------- 服务端 AI 能力（服务端持有密钥，前端永不接触） ----------

# ============================================================
# 1) 大模型对话（真心话小屋「自由层」）—— 二选一即可
# ============================================================
# 优先级：LLM_* 通用通道 > ANTHROPIC_* > 本地 Mock 模板
#
# 【推荐｜国产平台，可用支付宝/微信付款，不需要海外信用卡】
# 任意提供 OpenAI 兼容端点的模型都能挂上，只改这三行即可切换供应商：
#
#   供应商        LLM_BASE_URL                              LLM_MODEL
#   ---------------------------------------------------------------
#   DeepSeek      https://api.deepseek.com                  deepseek-flash
#   智谱 GLM      https://open.bigmodel.cn/api/paas/v4      glm-4-flash
#   通义千问      https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
#   Kimi          https://api.moonshot.cn/v1                moonshot-v1-8k
#   硅基流动      https://api.siliconflow.cn/v1             Qwen/Qwen3-8B
#   自建 vLLM     http://localhost:8000/v1                  你的模型名
#
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 【备选｜需要海外信用卡，一般较贵】Anthropic Claude
# 注意：LLM_* 配了的话会优先用它，Claude 会被忽略
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
CHAT_MODEL=claude-sonnet-4-5

# 【向后兼容别名】效果与 LLM_* 相同，LLM_* 优先
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# 2) 3D 形象生成（文字/图片 → 几何 + PBR 贴图）
TRIPO_API_KEY=
TRIPO_BASE_URL=https://api.tripo3d.ai/v2/openapi
MESHY_API_KEY=
MESHY_BASE_URL=https://api.meshy.ai/openapi/v2

# 3) 自动绑定骨骼 + 动物动画
ANYTHING_WORLD_API_KEY=
ANYTHING_WORLD_BASE_URL=https://api.anything.world

# 4) 语音合成（宠物专属音色）
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1

# 5) 语音识别（按住说话）
ASR_API_KEY=
ASR_BASE_URL=
ASR_MODEL=

# 6) 图像合成 / 手账排版（旅行照片合成、明信片）
IMAGE_COMPOSER_API_KEY=
IMAGE_COMPOSER_BASE_URL=

# ---------- 前端（Vite，构建期注入） ----------
# 前端只拿到 API 基地址，绝不放任何第三方密钥
VITE_API_BASE_URL=/api
VITE_APP_NAME=RuaTrip
